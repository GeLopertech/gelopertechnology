# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets to this file — it is tracked by git.

ADMIN_EMAIL=you@example.com
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
NOTION_TOKEN=YOUR_NOTION_TOKEN_HERE
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID_HERE

# reCAPTCHA v3 secret (server-side). Required — requests are rejected if missing.
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_HERE

# Random long string used to HMAC-sign math captcha challenges.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET=YOUR_RANDOM_CAPTCHA_SECRET_HERE

# Upstash Redis (REST) for global rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN_HERE
